# Copy to .env and adjust. Every value can also be supplied as a real environment variable.

# PostgreSQL connection (docker-compose.yml uses the same values)
DATATRUST_DB_HOST=localhost
DATATRUST_DB_PORT=5432
DATATRUST_DB_NAME=datatrust
DATATRUST_DB_USER=datatrust
DATATRUST_DB_PASSWORD=datatrust

# Schema holding DataTrust's own metadata (assets, rules, issues, ...)
DATATRUST_METADATA_SCHEMA=datatrust

# Synthetic data: the snapshot "as of" date, random seed and volume multiplier
DATATRUST_REFERENCE_DATE=2026-09-30
DATATRUST_SEED=20260930
DATATRUST_SCALE=1.0

# Quality ruleset used for warehouse runs: baseline | improved
DATATRUST_RULESET=improved

# Logging
DATATRUST_LOG_LEVEL=INFO
